# HEI ReBot Lift ports generated by debug/Port_Binding_Wizard.py
# Binding uses physical USB topology; keep each adapter in the same USB socket.
SUBSYSTEM=="tty", KERNELS=="1-4.4.3", ATTRS{idVendor}=="2e88", ATTRS{idProduct}=="4603", MODE:="0777", SYMLINK+="hei_right_arm"
SUBSYSTEM=="tty", KERNELS=="1-4.3.4", ATTRS{idVendor}=="2e88", ATTRS{idProduct}=="4603", MODE:="0777", SYMLINK+="hei_left_arm"
SUBSYSTEM=="tty", KERNELS=="1-4.1.3", ATTRS{idVendor}=="2e88", ATTRS{idProduct}=="4603", MODE:="0777", SYMLINK+="hei_lift"
SUBSYSTEM=="tty", KERNELS=="1-4.1.4", ATTRS{idVendor}=="2e88", ATTRS{idProduct}=="4603", MODE:="0777", SYMLINK+="hei_chassis"
SUBSYSTEM=="tty", KERNELS=="1-2.1.2", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0777", SYMLINK+="hei_lift_io"

# HEI ReBot Lift cameras selected interactively by debug/Port_Binding_Wizard.py
# Camera binding uses ID_PATH and video-index0; keep each camera in the same USB socket.
SUBSYSTEM=="video4linux", KERNEL=="video*", ENV{ID_PATH}=="platform-3610000.usb-usb-0:4.3.3:1.0", ATTR{index}=="0", SYMLINK+="hei_left_wrist_camera"
SUBSYSTEM=="video4linux", KERNEL=="video*", ENV{ID_PATH}=="platform-3610000.usb-usb-0:4.4.4:1.0", ATTR{index}=="0", SYMLINK+="hei_right_wrist_camera"

# Existing unrelated devices (IMU/lidar) are preserved below.
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60",ATTRS{serial}=="0001", MODE:="0777", GROUP:="dialout", SYMLINK+="wheeltec_FDI_IMU_GNSS"
KERNEL=="ttyACM*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4",ATTRS{serial}=="5B8E669679", MODE:="0777", GROUP:="dialout",SYMLINK+="wheeltec_lidar"
