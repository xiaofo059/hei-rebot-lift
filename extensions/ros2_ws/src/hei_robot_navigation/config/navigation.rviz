Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Map1
    Splitter Ratio: 0.45
  Tree Height: 500
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: Map
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.2
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
      body:
        Value: true
      odom:
        Value: true
      map:
        Value: true
    Marker Scale: 0.4
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: true
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: false
    Value: false
    Alpha: 0.12
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Value: true
    Alpha: 0.25
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
  - Class: rviz_default_plugins/Path
    Name: Global Path
    Enabled: true
    Value: true
    Alpha: 1
    Buffer Length: 1
    Color: 255; 150; 0
    Line Style: Billboards
    Line Width: 0.06
    Offset:
      X: 0
      Y: 0
      Z: 0.05
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
  - Class: rviz_default_plugins/Path
    Name: Local Path
    Enabled: true
    Value: true
    Alpha: 1
    Buffer Length: 1
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.03
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_plan
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 3.0
      Min Value: -0.5
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 0; 255; 255
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 163
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Live Scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.025
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /hei_robot_mapping/scan_cloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Value: true
    Alpha: 1
    Color: 0; 255; 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
  Enabled: true
  Global Options:
    Background Color: 20; 20; 24
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Pitch: 1.2
      Yaw: 1.5707963267948966
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Width: 1280
  Height: 720
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Time:
    collapsed: false
  Navigation 2:
    collapsed: false
