  <version>0.1.0</version>
  <description>MID-360S and FAST-LIO2 integration for RTAB-Map online mapping.</description>
  <maintainer email="user@localhost.invalid">HEI ReBot Lift developers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
