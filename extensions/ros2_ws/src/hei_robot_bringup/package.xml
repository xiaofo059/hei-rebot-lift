<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hei_robot_bringup</name>
  <version>0.1.0</version>
  <description>
    HEI ReBot Lift 自研 bringup：MID-360S 参数化启动、现场配置生成与原始 rosbag 离线验收工具。
    当前只覆盖 MID-360S 原始数据链路，不含定位/建图/导航。
  </description>
  <maintainer email="dev@hei-rebot-lift.invalid">HEI ReBot Lift</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 第三方 underlay：extensions/third_party/livox_ws（见 extensions/dependencies/livox.repos） -->
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
