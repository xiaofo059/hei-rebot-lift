diff --git a/sdk_core/CMakeLists.txt b/sdk_core/CMakeLists.txt
index 15e960d..256a183 100644
--- a/sdk_core/CMakeLists.txt
+++ b/sdk_core/CMakeLists.txt
@@ -138,6 +138,25 @@ target_sources(${SDK_LIBRARY_SHARED}
         ${LIVOX_SOURCES}
         )
 
+# HEI patch (HEI-LIDAR-20261017-02-FIX): export only the public Livox C API.
+# Bundled spdlog 1.3.1/fmt weak symbols otherwise leak into the dynamic symbol
+# table and are interposed by the system libspdlog.so.1 (1.9.2) that the ROS 2
+# logging backend loads into the same process -> SDK logger teardown crashes
+# (SIGBUS / "free(): invalid size").  Evidence and reproducer:
+# docs/agent/evidence/mid360s/20261017-fix/.
+if(UNIX AND NOT APPLE)
+  set(LIVOX_SHARED_VERSION_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/livox_lidar_sdk_shared.map")
+  if(NOT EXISTS "${LIVOX_SHARED_VERSION_SCRIPT}")
+    message(FATAL_ERROR "缺少符号导出脚本 ${LIVOX_SHARED_VERSION_SCRIPT}")
+  endif()
+  set_property(TARGET ${SDK_LIBRARY_SHARED} APPEND_STRING PROPERTY LINK_FLAGS
+    " -Wl,--version-script=${LIVOX_SHARED_VERSION_SCRIPT}")
+  # LINK_DEPENDS：只修改导出 map 时增量构建也必须重新链接
+  set_property(TARGET ${SDK_LIBRARY_SHARED} APPEND PROPERTY LINK_DEPENDS
+    "${LIVOX_SHARED_VERSION_SCRIPT}")
+  message(STATUS "Livox-SDK2 shared lib symbol export script: ${LIVOX_SHARED_VERSION_SCRIPT}")
+endif(UNIX AND NOT APPLE)
+
 install(TARGETS ${SDK_LIBRARY_STATIC} ${SDK_LIBRARY_SHARED}
         PUBLIC_HEADER DESTINATION include
         ARCHIVE DESTINATION lib
