 #include <cstdlib>
 #include <chrono>
@@ -193,18 +194,26 @@ void PubHandler::CheckTimer(uint32_t id) {
       frame_.lidar_num = 0;
     }
   } else { // Disable time synchronization
-    auto now_time = std::chrono::high_resolution_clock::now();
-    //First Set
+    // HEI patch: schedule on steady_clock, never on CLOCK_REALTIME.
+    // Upstream used high_resolution_clock (= CLOCK_REALTIME on libstdc++), so a
+    // host clock step backwards made "now - last_pub_time_" negative and the
+    // publish loop stalled for the whole step, dumping the accumulated points
+    // as one oversized frame (02-LIVE 2026-10-16: 0.70 s stall / 140,736 points).
+    // steady_clock is monotonic and unaffected by NTP/VM clock steps.
+    const std::chrono::steady_clock::time_point now_time =
+        std::chrono::steady_clock::now();
+    // First Set
     static bool first = true;
     if (first) {
       last_pub_time_ = now_time;
       first = false;
       return;
     }
-    if (now_time - last_pub_time_ < std::chrono::nanoseconds(publish_interval_)) {
+    const std::chrono::nanoseconds publish_interval{publish_interval_};
+    if (now_time - last_pub_time_ < publish_interval) {
       return;
     }
-    last_pub_time_ += std::chrono::nanoseconds(publish_interval_);
+    last_pub_time_ += publish_interval;
     for (auto &process_handler : lidar_process_handlers_) {
       frame_.base_time[frame_.lidar_num] = process_handler.second->GetLidarBaseTime();
       uint32_t handle = process_handler.first;
@@ -268,10 +277,17 @@ uint64_t PubHandler::GetEthPacketTimestamp(uint8_t timestamp_type, uint8_t* time
 
   if (timestamp_type == kTimestampTypeGptpOrPtp ||
       timestamp_type == kTimestampTypeGps) {
+    // PTP/GPS path: device timestamps are used as-is, so genuine sensor-time
+    // regressions stay visible to the bag QC (not masked by the HEI patch).
     return time.stamp;
   }
 
-  return std::chrono::high_resolution_clock::now().time_since_epoch().count();
+  // NoSync path (confirmed for both MID-360S ports 56301/56401 on 2026-10-17:
+  // time_type == 0).  Upstream substituted CLOCK_REALTIME, so host clock steps
+  // moved LiDAR and IMU header stamps backwards.  Use the monotonic,
+  // epoch-anchored host clock instead (see host_time.h); LiDAR and IMU share the
+  // same mapping, so both streams stay on one timeline.
+  return HostNowNs();
 }
 
