diff --git a/src/comm/host_time.h b/src/comm/host_time.h
new file mode 100644
index 0000000..58d6853
--- /dev/null
+++ b/src/comm/host_time.h
@@ -0,0 +1,79 @@
+//
+// HEI patch (HEI-LIDAR-20261017-02-FIX): monotonic epoch time source.
+//
+// The upstream driver substitutes the host wall clock
+// (`std::chrono::high_resolution_clock`, which is CLOCK_REALTIME on libstdc++)
+// for packets whose `time_type` is kTimestampTypeNoSync (see
+// pub_handler.cpp: GetEthPacketTimestamp), and also schedules the non-sync
+// publish loop with the same clock.  Any CLOCK_REALTIME step (NTP/VM) therefore
+// (a) moves LiDAR and IMU header stamps backwards and (b) freezes the publish
+// scheduler for the size of the step, dumping the accumulated buffer as one
+// oversized frame.
+//
+// Measured on the 02-LIVE 2026-10-16 incident bag: host CLOCK_REALTIME stepped
+// back ~598 ms; both streams regressed once in true recording order; the
+// non-sync scheduler stalled and then emitted a 140,736-point frame spanning
+// 702.866 ms.  See docs/agent/evidence/mid360s/20261017-fix/.
+//
+// This helper keeps the packet timeline monotonic without touching the
+// PTP/GPS path: one system_clock epoch anchor is captured at first use, then
+// epoch ns = anchor_epoch_ns + (steady_clock elapsed).  The result is anchored
+// to the host epoch at driver start; it is NOT hardware time synchronisation.
+//
+// Boundary: if a device switches `time_type` at runtime (NoSync <-> PTP/GPS),
+// the timestamp domain changes once and a step may be visible.  The synced path
+// still reports real device-time regressions unchanged, so QC cannot be
+// masked by this helper.
+//
+#ifndef LIVOX_ROS_DRIVER2_COMM_HOST_TIME_H_
+#define LIVOX_ROS_DRIVER2_COMM_HOST_TIME_H_
+
+#include <chrono>
+#include <cstdint>
+
+namespace livox_ros {
+
+struct HostClockAnchors {
+  std::uint64_t epoch_ns;
+  std::uint64_t steady_ns;
+};
+
+// Pure mapping helper (unit-tested without touching the real clocks).
+inline std::uint64_t MapSteadyToEpochNs(std::uint64_t anchor_epoch_ns,
+                                        std::uint64_t anchor_steady_ns,
+                                        std::uint64_t steady_now_ns) {
+  return anchor_epoch_ns + (steady_now_ns - anchor_steady_ns);
+}
+
+inline HostClockAnchors MakeHostClockAnchors() {
+  const auto epoch = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::system_clock::now().time_since_epoch());
+  const auto steady = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch());
+  HostClockAnchors anchors;
+  anchors.epoch_ns = static_cast<std::uint64_t>(epoch.count());
+  anchors.steady_ns = static_cast<std::uint64_t>(steady.count());
+  return anchors;
+}
+
+// Function-local static => thread-safe one-time initialisation (C++11).
+inline const HostClockAnchors& HostClockAnchorsInstance() {
+  static const HostClockAnchors anchors = MakeHostClockAnchors();
+  return anchors;
+}
+
+// Monotonic epoch-anchored "now" in ns.  Reads CLOCK_REALTIME only once, at the
+// first anchor capture, so later clock steps cannot move timestamps backwards.
+inline std::uint64_t HostNowNs() {
+  // Anchor first, steady sample second: on the very first call this guarantees
+  // steady_now >= anchor_steady, so the uint64 arithmetic cannot underflow.
+  const HostClockAnchors& anchors = HostClockAnchorsInstance();
+  const auto steady = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch());
+  return MapSteadyToEpochNs(anchors.epoch_ns, anchors.steady_ns,
+                            static_cast<std::uint64_t>(steady.count()));
+}
+
+}  // namespace livox_ros
+
+#endif  // LIVOX_ROS_DRIVER2_COMM_HOST_TIME_H_
